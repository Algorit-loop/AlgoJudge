# Copy to .env and adjust. Every value has a default in compose.yaml, so .env is optional for development.

# Port nginx listens on, on the host.
HTTP_PORT=8080

POSTGRES_USER=algojudge
POSTGRES_PASSWORD=algojudge
POSTGRES_DB=algojudge

# Your user/group id on the host (`id -u` / `id -g`), so files the containers write into the repo belong to you.
HOST_UID=1000
HOST_GID=1000

# Accounts: allow anyone to sign up from the web (false = only admins create accounts via the CLI).
REGISTRATION_OPEN=true
# Set to true when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
