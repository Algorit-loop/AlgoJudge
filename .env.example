# Sample configuration. `./scripts/init.sh` copies it to .env (the real configuration, not in git) and fills in
# a random POSTGRES_PASSWORD. Edit .env, never this file, then `docker compose up -d` to apply.
# Every value also has a default in compose.yaml / site/algojudge/config.py.

# Port nginx listens on, on the host.
HTTP_PORT=8080

# Database account. The password only takes effect when the database is first created (empty data/postgres/);
# changing it afterwards needs ALTER USER inside PostgreSQL as well.
POSTGRES_USER=algojudge
POSTGRES_PASSWORD=algojudge
POSTGRES_DB=algojudge

# Accounts: allow anyone to sign up from the web (false = only admins create accounts via the CLI).
REGISTRATION_OPEN=true
# Set to true when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
